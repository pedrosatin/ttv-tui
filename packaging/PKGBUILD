# Maintainer: Pedro Satin
#
# Como atualizar este PKGBUILD para uma nova versão:
#   Execute: ./packaging/update-pkgbuild.sh <versao> <caminho/checksums.txt>
#   Exemplo: ./packaging/update-pkgbuild.sh 0.1.0 dist/checksums.txt
# Ou atualize manualmente os campos pkgver, sha256sums_x86_64 e sha256sums_aarch64
# com os hashes SHA-256 do arquivo checksums.txt publicado no release do GitHub.

pkgname=ttv-tui-bin
pkgver=0.1.4
pkgrel=1
pkgdesc="Twitch no terminal: navegue por categorias, assista canais e converse no chat"
arch=('x86_64' 'aarch64')
url="https://github.com/pedrosatin/ttv-tui"
license=('MIT')
depends=('streamlink' 'mpv')
optdepends=(
  'sqlite: necessário apenas para ttv-tui login --from-browser'
)
provides=('ttv-tui')
conflicts=('ttv-tui')

source_x86_64=("${url}/releases/download/v${pkgver}/ttv-tui_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/ttv-tui_${pkgver}_linux_arm64.tar.gz")

sha256sums_x86_64=('c475bf4105a9e82aec93b444f3d79b951ab362c4e48854a13888be022c90c47b')
sha256sums_aarch64=('04d8e0822c5910d989b5469d8ae748ff3b0b96dbf2d1af2f35f65b85bac12404')

package() {
  install -Dm755 "${srcdir}/ttv-tui" "${pkgdir}/usr/bin/ttv-tui"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
